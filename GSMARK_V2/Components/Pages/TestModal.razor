@page "/testdialog"
@rendermode InteractiveServer
@using GSMARK_V2.Components.Modals
@using MudBlazor
@inject IDialogService DialogService

<MudDialogProvider />

<MudButton @onclick="OpenDialogAsync" Variant="Variant.Filled" Color="Color.Primary">
    Abrir dialog
</MudButton>

@code {
    private async Task OpenDialogAsync()
    {
        Console.WriteLine("Intentando abrir el dialog");

        var options = new DialogOptions
        {
            CloseOnEscapeKey = false, // No cerrar con tecla Escape
            CloseButton = false
        };

        var dialog = await DialogService.ShowAsync<Dialog>("Prueba de Modal", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Console.WriteLine("Diálogo aceptado");
        }
        else
        {
            Console.WriteLine("Diálogo cancelado");
        }
    }
}
