<MudDialog @onkeydown="HandleKeyDown" tabindex="0">
    <DialogContent>

        <MudTextField @bind-Value="_coProd" Label="Codígo Producto" Variant="Variant.Outlined" ReadOnly="true" />

        <MudTextField @bind-Value="_coItemRef" Label="Ref. Artículo Almacén" Immediate="true"
                      OnBlur="BuscarProductoPorReferencia"
                      OnKeyDown="@(async (e) => await OnItemCodeKeyDown(e))"
                      Variant="Variant.Outlined" Required="true" />

        <MudTextField @bind-Value="@_desItemRef" Label="Desc. Item Orig." Variant="Variant.Outlined" ReadOnly="true" />

        <MudTextField @bind-Value="_deProd" Label="Descripción" Variant="Variant.Outlined" Required="true" />
        <MudNumericField @bind-Value="_precioUnit" Label="Precio Unit. S/." Variant="Variant.Outlined" Required="true" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private string _coProd;
    private string _coItemRef;
    private string _desItemRef;
    private string _deProd;
    private decimal _precioUnit;


    private async Task BuscarProductoPorReferencia()
    {
        if (!string.IsNullOrWhiteSpace(_coItemRef))
        {
            var prod = await TMPRODService.GetProdByCodItemASync(_coItemRef);
            if (prod != null)
            {
                _desItemRef = prod.DE_ITEM;
                Snackbar.Add("Referencia encontrada", Severity.Info);
            }
            else
            {
                _desItemRef = string.Empty;
                Snackbar.Add("No se encontró el producto con esa referencia", Severity.Warning);
            }
        }
    }


    private async Task OnItemCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_coItemRef))
        {
            var item = await TMPRODService.GetProdByCodItemASync(_coItemRef);

            if (item != null)
            {
                _desItemRef = item.DE_ITEM; // lo que devuelve el SP
            }
            else
            {
                _desItemRef = string.Empty;

                Snackbar.Add("El código ingresado no existe o está inactivo.", Severity.Warning);
            }
        }
    }

    // 🔹 Detectar tecla presionada dentro del dialog
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Code == "F2")
        {
            // var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = false, FullWidth = true };
            // await DialogService.ShowAsync<SecondDialog>("Segundo Dialog", options);

            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            var dialog = await DialogService.ShowAsync<DialogTMITEN>("Buscar Producto", options);

            var result = await dialog.Result;

            if (!result.Canceled && result.Data is TMITEMDTO selectedItem)
            {
                // cuando selecciona el producto en el segundo dialog
                _coItemRef = selectedItem.CO_ITEM;
                _desItemRef = selectedItem.DE_ITEM;
            }
        }
    }


    private void Cancelar()
    {
        MudDialog.Cancel();
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_coItemRef) || string.IsNullOrWhiteSpace(_deProd))
        {
            Snackbar.Add("Complete los campos obligatorios", Severity.Error);
            return;
        }

        var nuevoProducto = new TMPRODDTO
        {
            CO_PROD = _coProd,
            CO_ITEM_REFE = _coItemRef,
            DE_ITEM = _desItemRef,
            DE_PROD = _deProd,
            IM_PREC_UNIT = _precioUnit
        };

        // llamado al servicio real
        // await TMPRODService.InsertProductAsync(nuevoProducto);

        Snackbar.Add("Producto registrado con éxito", Severity.Success);
        MudDialog.Close(DialogResult.Ok(nuevoProducto));
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _coProd = await TMPRODService.GetNextCoProdAsync();
        }
        catch(Exception ex)
        {
            Snackbar.Add($"Error al obtener el siguiente código de producto: {ex.Message}", Severity.Error);
            _coProd = string.Empty;
        }
    }


}
