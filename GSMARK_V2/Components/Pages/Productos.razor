@page "/productos"
@using GSMARK_V2.Models
@using MudBlazor
@inject GSMARK_V2.Interfaces.ITMPRODService TMPRODService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5">
    <MudText Typo="Typo.h5" GutterBottom="true">Listado de Productos</MudText>

    <MudPaper Elevation="3" Class="pa-4" Width="100%">
        <MudTable Items="@productos"
                  Dense="true"
                  Striped="true"
                  Bordered="true"
                  Filter="new Func<TMPROD,bool>(FilterFunc)"
                  RowsPerPage="10"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm">
            
            <ToolBarContent>
                <MudSpacer />
                <MudTextField @bind-Value="searchString"
                              Placeholder="Buscar producto..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <HeaderContent>
                <MudTh>Id. Producto</MudTh>
                <MudTh>Item Referencia</MudTh>
                <MudTh>Descripción</MudTh>
                <MudTh>Precio Unitario</MudTh>
            </HeaderContent>

            <RowTemplate Context="producto">
                <MudTd DataLabel="Id. Producto">@producto.CO_PROD</MudTd>
                <MudTd DataLabel="Item Referencia">@producto.CO_ITEM_REFE</MudTd>
                <MudTd DataLabel="Descripción">@producto.DE_PROD</MudTd>
                <MudTd DataLabel="Precio Unitario">@producto.IM_PREC_UNIT.ToString("0.00")</MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private IEnumerable<TMPROD> productos = new List<TMPROD>();
    private string searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        productos = await TMPRODService.GetProductsAsync("A");
    }

    private bool FilterFunc(TMPROD producto)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return
            (producto.CO_PROD?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (producto.CO_ITEM_REFE?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (producto.DE_PROD?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }
}
