@using GSMARK_V2.DTO
@using GSMARK_V2.Interfaces
@using GSMARK_V2.Models
@using GSMARK_V2.Services
@using MudBlazor
@inject ITMPRODService TMPRODService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ITMITEMService TMITEMService

<MudDialog Title="Buscar Producto">
    <DialogContent>
        <MudTextField @bind-Value="_search" Placeholder="Buscar por código o descripción..."
                      Immediate="true" OnKeyDown="@(async e => await OnSearchKeyDown(e))" />

        <MudTable Items="_items" Hover="true" Dense="true" Bordered="true">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Descripción</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">@context.CO_ITEM</MudTd>
                <MudTd DataLabel="Descripción">@context.DE_ITEM</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" OnClick="@(() => SelectItem(context))">Seleccionar</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private string _search;
    private List<TMITEMDTO> _items = new(); // se llena desde servicio

    private void SelectItem(TMITEMDTO item)
    {
        MudDialog.Close(DialogResult.Ok(item));
    }

    private void Cancelar() => MudDialog.Cancel();


    // 🔹 Cuando se presiona Enter en el campo de búsqueda
    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_search))
        {
            _items = (await TMITEMService.BuscarPorCadenaAsync(_search))
                     .Select(x => new TMITEMDTO { CO_ITEM = x.CO_ITEM, DE_ITEM = x.DE_ITEM })
                     .ToList();
            StateHasChanged();

            if (_items.Count == 0)
                Snackbar.Add("No se encontraron resultados", Severity.Warning);
        }
    }



    protected override async Task OnInitializedAsync()
    {
        // carga inicial con "I" (busqueda por inicio)
        _items = (await TMITEMService.BuscarPorInicioAsync("")).Select(x => new TMITEMDTO
        {
            CO_ITEM = x.CO_ITEM,
            DE_ITEM = x.DE_ITEM
        }).ToList();
    }
}
