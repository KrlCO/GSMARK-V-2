@using MudBlazor
@rendermode InteractiveServer
@inject IDialogService DialogService

<h3>Busqueda Personalizada</h3>
<div class="fixed inset-0 z-50" style="@(IsOpen ? "display:block;" : "display:none;")">
    <!-- Fondo semi-transparente -->
    <div class="fixed inset-0 bg-black bg-opacity-50" @onclick="CloseDrawer"></div>

    <!-- Drawer -->
    <div class="fixed top-0 right-0 w-96 h-full bg-white shadow-lg flex flex-col transition-transform duration-300"
         style="@(IsOpen ? "transform: translateX(0);" : "transform: translateX(100%);")">

        <!-- Encabezado -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-lg font-bold">@Title</h2>
            <button class="text-gray-600 hover:text-black" @onclick="CloseDrawer">✖</button>
        </div>

        <!-- Contenido -->
        <div class="flex-1 overflow-y-auto p-4">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Detalle";

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
